UnlitTwoTexture
{
	$basetexture 		"ui/r1d_red_menu_selected"
	$texture2			"ui/menu_selected_scroll"

	$translucent 		1
	$vertexcolor 		1
	$vertexalpha 		1
	$ignorez    		1
	$additive			1
	$no_fullbright		1

    Proxies
    {
		TextureScroll
		{
			texturescrollvar	$texture2Transform
			texturescrollrate	0.25
			texturescrollangle	270
		}
    }
}

