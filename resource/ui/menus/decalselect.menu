			textAlignment			west

			pin_to_sibling 			LblInfoPanelItemDesc
			pin_corner_to_sibling	0
			pin_to_sibling_corner	2
		}

		LblInfoPanelItemReq
		{
			ControlName				Label
			classname 				DecalReqClass
			xpos					0
			ypos 					0
			wide 					180
			tall 					50
			zpos					8
			visible					1
			font					DecalReqFont
			allcaps					0
			wrap 					1
			fgcolor_override		"230 161 23 255"
			labelText				""
			textAlignment			north-west

			pin_to_sibling 			LblInfoPanelItemReqHeader
			pin_corner_to_sibling	0
			pin_to_sibling_corner	2
		}

		LblInfoPanelProgress
		{
			ControlName				Label
			classname 				DecalProgressClass
			xpos					0
			ypos 					0
			wide 					180
			tall 					40
