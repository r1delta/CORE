resource/ui/menus/decalselect.menu
{
	DecalSelectMenu
	{
		ControlName				Frame
		xpos					0
		ypos					0
		zpos					3
		wide					f0
		tall					f0
		autoResize				0
		pinCorner				0
		visible					1
		enabled					1
		PaintBackgroundType		0
		infocus_bgcolor_override	"0 0 0 0"
		outoffocus_bgcolor_override	"0 0 0 0"
		modal					1
		clip					0

		Background
		{
			ControlName				Label
			ypos 					-500
			wide					f0
			tall					1000
			labelText 				""
			visible					1
			bgcolor_override		"0 0 0 240"
			paintbackground			1
		}

		MenuPanel
		{
			ControlName				ImagePanel
			xpos					c-360
			ypos 					c-150
			wide					720
			tall					333
			image 					"../ui/menu/titanDecal_menu/decalMenuBack"
			visible					1
			scaleImage				1
		}

		//------------------
		// 	  INFO PANEL
		//------------------

		DecalBackgroundLarge
		{
			ControlName				ImagePanel
			xpos					-100
			ypos 					-24
			wide					120
			tall					120
			image 					"../ui/menu/titanDecal_menu/decalSlot_default"
			visible					1
			scaleImage				1

			pin_to_sibling			MenuPanel
			pin_corner_to_sibling	1
			pin_to_sibling_corner	1
		}

		DecalImageLarge
		{
			ControlName				ImagePanel
			classname 				DecalIconClass
			wide					90
			tall					90
			xpos 					0
			ypos					0
			image 					"../models/titans/custom_decals/decal_pack_01/wings_custom_decal_menu"
			visible					1
			scaleImage				1

			pin_to_sibling			DecalBackgroundLarge
			pin_corner_to_sibling	8
			pin_to_sibling_corner	8
		}

		LblDLCRequired
		{
			ControlName				Label
			classname				LblDLCRequired
			xpos					-10
			ypos 					0
			zpos 					102
			wide					100
			tall					120
			centerwrap 				1
			visible					1
			font					LoadoutItemLocked
			allcaps					1
			textAlignment			center
			labelText				"#DLC_NOT_PURCHASED"
			fgcolor_override		"153 61 61 255"
			bgcolor_override		"51 20 20 240"

			pin_to_sibling			DecalBackgroundLarge
			pin_corner_to_sibling	0
			pin_to_sibling_corner	1
		}

		LblMenuTitle
		{
			ControlName				Label
			xpos					-16
			ypos 					-6
			wide 					204
			tall 					16
			zpos					8
			visible					1
			font					EditLoadoutInfoItemName
			allcaps					1
			fgcolor_override		"255 133 133 255"
			labelText				"#DECAL_MENU_HEADER"
			textAlignment			west

			pin_to_sibling			DecalBackgroundLarge
			pin_corner_to_sibling	2
			pin_to_sibling_corner	0
		}

		LblInfoPanelItemName
		{
			ControlName				Label
			classname 				DecalNameClass
			xpos					-16
			ypos 					-6
			wide 					180
			tall 					16
			zpos					8
			visible					1
			font					DecalNameFont
			auto_tall_tocontents	1
			wrap 					1
			allcaps					1
			fgcolor_override		"255 133 133 255"
