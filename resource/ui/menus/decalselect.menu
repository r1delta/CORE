			visible					1
			font					DecalReqFont
			allcaps					0
			wrap 					1
			fgcolor_override		"200 200 200 255"//"230 161 23 255"
			labelText				""
			textAlignment			north-west

			pin_to_sibling 			LblInfoPanelItemReq
			pin_corner_to_sibling	0
			pin_to_sibling_corner	2
		}

		//------------------------
		//     DECAL BUTTONS
		//------------------------

		DecalButtonsPanel
		{
			ControlName				CNestedPanel
			classname				DecalButtonsPanel
			xpos					-10
			ypos					-8
			zpos					200
			wide					468
			tall					320
			visible					1
