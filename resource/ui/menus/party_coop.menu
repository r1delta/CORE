		CoopQuickMatchButton
		{
			ControlName				BaseModHybridButton
			classname 				CoopQuickMatchButtonClass
			InheritProperties		LargeButton
			xpos					30
			ypos					85
			zpos 					900
			navUp					BtnRegen
			navDown					CoopCreateAMatchButton
			navRight				ListFriendlies
			tabPosition				1
			labelText				"#COOP_QUICKPLAY"
		}

		CoopCreateAMatchButton
		{
			ControlName				BaseModHybridButton
			classname 				CoopCreateAMatchButtonClass
			InheritProperties		LargeButton
			ypos					-1
			zpos 					900
			pin_to_sibling			CoopQuickMatchButton
			pin_corner_to_sibling	0
			pin_to_sibling_corner	2
			navUp					CoopQuickMatchButton
			navDown					BtnEditPilotLoadouts
