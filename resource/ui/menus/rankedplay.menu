			navUp					BtnRankedButton
			navDown					BtnSeasons

			pin_to_sibling			BtnRankedButton
			pin_corner_to_sibling	0
			pin_to_sibling_corner	2
		}

		BtnSeasons
		{
			ControlName				BaseModHybridButton
