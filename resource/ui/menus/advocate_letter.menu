resource/ui/menus/advocate_letter.menu
{
	Advocate_Letter
	{
		ControlName					Frame
		xpos						0
		ypos						0
		zpos						3
		wide						f0
		tall						f0
		autoResize					0
		pinCorner					0
		visible						1
		enabled						1
		PaintBackgroundType			0
		infocus_bgcolor_override	"0 0 0 0"
		outoffocus_bgcolor_override	"0 0 0 0"

		BackgroundImage
		{
			ControlName				ImagePanel
			classname				BackgroundImageClass
			zpos					3
			wide					f0
			tall					f0
			visible					1
			scaleImage				1
			image 					"black"
		}

		BlackBackground
		{
			ControlName				ImagePanel
			classname				BlackBackground
			xpos					0
			ypos					0
			zpos					9
			wide					%100
			tall					%100
			visible					1
			scaleImage				1
			image					HUD/white
			drawColor				"0 0 0 255"
		}

		RankPlayImage
		{
			ControlName				ImagePanel
			xpos					c-57//c+200
			ypos					c-200
			zpos					200
			wide					114
			tall					114
			visible					1
			image 					"../ui/scoreboard_secret_logo_noscan"
			alpha 					200
			visible					1
			scaleImage				1
		}


		AdvocateLine0
		{
			ControlName				Label
			classname 				AdvocateLine
			xpos					0
			ypos					c-75
			zpos					10
			tall					16
			wide					f0
			visible					1
			font					RegenAdvocateText
			allcaps					1
			textAlignment			center
			fgcolor_override		"255 133 133 255"
			labelText				"--"
		}

		AdvocateLine1
		{
			ControlName				Label
			InheritProperties		AdvocateLine
			zpos					10

			pin_to_sibling			AdvocateLine0
			pin_corner_to_sibling	4
			pin_to_sibling_corner	6
		}

		AdvocateLine2
		{
			ControlName				Label
			InheritProperties		AdvocateLine
			zpos					10

			pin_to_sibling			AdvocateLine1
			pin_corner_to_sibling	4
			pin_to_sibling_corner	6
		}

		AdvocateLine3
		{
			ControlName				Label
			InheritProperties		AdvocateLine
			zpos					10

			pin_to_sibling			AdvocateLine2
			pin_corner_to_sibling	4
			pin_to_sibling_corner	6
		}

		AdvocateLine4
		{
			// for future use of this menu, should make alt
			// right-justified lines for byline, so its not
			// hard coded to 5th line
			ControlName				Label
			classname 				AdvocateLine
			xpos					100
			zpos					10
			tall					16
			wide					f0
			visible					1
			font					RegenAdvocateText
			allcaps					1
			fgcolor_override		"255 133 133 255"
