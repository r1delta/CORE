//////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// Paging (three rows; the mouse wheel scrolls one row). Hidden by the script when every map fits on a single page.
//////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

		PrevPageButton
		{
			ControlName				BaseModHybridButton
			InheritProperties		CompactButton
			classname				MapPageUpClass
			xpos					c-373
			ypos					388
			wide					150
			labelText				"PREVIOUS PAGE"
			navUp					MapButton6
			navRight				NextPageButton
		}

		NextPageButton
		{
			ControlName				BaseModHybridButton
			InheritProperties		CompactButton
			classname				MapPageDownClass
			xpos					c-31
			ypos					388
			wide					150
			labelText				"NEXT PAGE"
			navUp					MapButton8
			navLeft					PrevPageButton
			navRight				RandomMapButton
		}

		RandomMapButton
		{
			ControlName				BaseModHybridButton
			InheritProperties		CompactButton
			classname				MapRandomClass
			xpos					104
			ypos					r55
			wide					130
			labelText				"RANDOM MAP"
			navUp					MapButton8
			navLeft					NextPageButton
		}

		RandomMapGamepadHint
		{
			ControlName				Label
			xpos					190
			ypos					r53
			auto_wide_tocontents	1
			tall					16
			visible					0
			labelText				"#MAP_RANDOM_GLYPH"
			font					FooterFont
			allcaps					1
			activeInputExclusivePaint	gamepad
		}

		PageLabel
		{
			ControlName				Label
			xpos					c-223
			ypos					389
			wide					192
			tall					18
			visible					1
			labelText				""
			textAlignment			center
			font					PlaylistDescriptionFont
			allcaps					1
			fgcolor_override		"204 234 255 255"
		}

