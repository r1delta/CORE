		}

		ImgBottomBar
		{
			ControlName				ImagePanel
			InheritProperties		MenuBottomBar
		}

//////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// Map tile grid. 3 columns x 3 rows of tiles; the script fills them from a scrolling window over the full map list.
// Layout is anchored to screen centre ("c") so it holds at any aspect ratio. Virtual screen is 854x480.
//////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

		MapButtonsBackground
		{
			ControlName				ImagePanel
			xpos					c-373
			ypos					92
			wide					492
			tall					288
			visible					1
			scaleImage				1
			image					"../ui/menu/campaign_menu/map_image_back"
		}

		MapButton0
		{
			ControlName				BaseModHybridButton
			InheritProperties		MapButton
			classname				MapButtonClass
			scriptID				0
			xpos					c-368
			ypos					98
			tabPosition				1
			navDown					MapButton3
			navRight					MapButton1
			labelText				""
		}

		MapButton1
		{
			ControlName				BaseModHybridButton
			InheritProperties		MapButton
