resource/ui/menus/burncards_pickcard.menu
{
	BurnCards_PickCard
	{
		ControlName				Frame
		xpos					0
		ypos					0
		zpos					3
		wide					f0
		tall					f0
		autoResize				0
		pinCorner				0
		visible					1
		enabled					1
		PaintBackgroundType		0
		infocus_bgcolor_override	"0 0 0 0"
		outoffocus_bgcolor_override	"0 0 0 0"

		BackgroundOverlay
		{
			ControlName				Label
			InheritProperties		BackgroundDarken
		}

		MenuTitle
		{
			ControlName				Label
			InheritProperties		MenuTitle
			labelText				"#MENU_BURNCARD_MENU"
		}

		ImgTopBar
		{
			ControlName				ImagePanel
			InheritProperties		MenuTopBar
		}

		ImgBottomBar
		{
			ControlName				ImagePanel
			InheritProperties		MenuBottomBar
		}

		ImgTitanfallLogoSmall
		{
			ControlName				ImagePanel
			InheritProperties		TitanfallLogoSmall
		}

		NewBurnCardDialog
		{
			ControlName				ImagePanel
			xpos					50 //c-190
			ypos					90 //250
			zpos					52

			wide					380
			tall					240 // 236
			image 					"../ui/menu/common/pop_up_menu_big_back"
			scaleImage				1
		}

		PreviewCard_NestedPanel
		{
			ControlName			CNestedPanel
			xpos				20
			ypos				0

			zpos				50

			wide				227
			tall				316

			visible				1

			controlSettingsFile	"scripts/screens/vgui_burn_card.res"

			scaleImage			1
			drawColor			"255 255 255 255"

			pin_to_sibling			NewBurnCardDialog
			pin_corner_to_sibling	0
			pin_to_sibling_corner	1
		}

		NewBurnCardTitle
		{
			ControlName				Label
			//classname				DialogMessageClass
			xpos					0
			ypos					-45
			zpos					53 // Needed or clicking on the background can hide this
			wide					300
			tall					20
			labelText				"#BC_SELECT_BURN_CARD"
			font					DialogMessageFont
			textAlignment			center
			wrap					1
			centerwrap				1
			allcaps					1
			fgcolor_override		"255 133 133 255"

			pin_to_sibling			NewBurnCardDialog
			pin_corner_to_sibling	4
			pin_to_sibling_corner	4
		}

		BtnBurnCardPickCard_1
		{
			ControlName				BaseModHybridButton
			InheritProperties		BurnCardButton
			style					BurnCardThumbnailButton
