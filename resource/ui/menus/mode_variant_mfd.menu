			scriptID				0
			xpos					30
			ypos					86
			navUp					BtnMode4
			navDown					BtnMode2
			labelText				""
		}
		BtnMode2
		{
			ControlName				BaseModHybridButton
			InheritProperties		DefaultButton
			classname 				ModeVariantButton
			scriptID				1
			pin_to_sibling			BtnMode1
			pin_corner_to_sibling	0
			pin_to_sibling_corner	2
			navUp					BtnMode1
			navDown					BtnMode3
			labelText				""
		}
		BtnMode3
		{
			ControlName				BaseModHybridButton
			InheritProperties		DefaultButton
			classname 				ModeVariantButton
			scriptID				2
			pin_to_sibling			BtnMode2
			pin_corner_to_sibling	0
			pin_to_sibling_corner	2
			navUp					BtnMode2
			navDown					BtnMode4
			labelText				""
		}
		BtnMode4
		{
			ControlName				BaseModHybridButton
			InheritProperties		DefaultButton
			classname 				ModeVariantButton
			scriptID				3
			pin_to_sibling			BtnMode3
			pin_corner_to_sibling	0
			pin_to_sibling_corner	2
