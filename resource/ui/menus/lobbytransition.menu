resource/ui/menus/lobbytransition.menu
{
	LobbyTransition
	{
		ControlName				Frame
		xpos					0
		ypos					0
		zpos					3
		wide					f0
		tall					f0
		autoResize				0
		pinCorner				0
		visible					1
		enabled					1
		tabPosition				0
		PaintBackgroundType		0
		infocus_bgcolor_override	"0 0 0 0"
		outoffocus_bgcolor_override	"0 0 0 0"
		modal					1

		ImgDialog
		{
			ControlName				ImagePanel
			wide					f0
			tall					f0
			image 					"../ui/menu/common/pop_up_menu_back"
			visible					1
			scaleImage				1
		}

		LblMessage
		{
			ControlName				Label
			classname				DialogMessageClass
			xpos					c-150
			ypos					c-55
			zpos					3 // Needed or clicking on the background can hide this
			wide					300
			tall					50
			visible					1
			labelText				""
			font					DialogMessageFont
			textAlignment			"north"
			wrap					1
			centerwrap				1
			allcaps					1
			fgcolor_override		"255 133 133 255"
		}

		ImgMatchmakingStatus
		{
			ControlName				ImagePanel
			classname 				MatchmakingStatusIconClass
			pin_to_sibling			ImgTopBar
			pin_corner_to_sibling	3
			pin_to_sibling_corner	1
			xpos					c-40
			ypos					c-20
			wide					80
			tall					80
			visible					1
			scaleImage				1
			image					"../ui/icon_processing"
		}
	}
}
